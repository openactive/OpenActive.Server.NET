{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
          "build",
          "${workspaceFolder}/Examples/BookingSystem.AspNetCore/BookingSystem.AspNetCore.csproj",
          "--configuration",
          "Debug"
      ],
      "problemMatcher": "$msCompile",
      "group": {
          "kind": "build",
          "isDefault": true
      }
    },
    {
      "label": "publish",
      "command": "dotnet",
      "type": "process",
      "args": [
          "publish",
          "${workspaceFolder}/Examples/BookingSystem.AspNetCore/BookingSystem.AspNetCore.csproj",
          "--configuration",
          "Release"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch",
      "command": "dotnet",
      "type": "process",
      "args": [
          "watch",
          "run",
          "--project",
          "${workspaceFolder}/Examples/BookingSystem.AspNetCore/BookingSystem.AspNetCore.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "clean",
      "command": "dotnet",
      "type": "process",
      "args": [
          "clean",
          "${workspaceFolder}/Examples/BookingSystem.AspNetCore/BookingSystem.AspNetCore.csproj"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}